{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "build:ssr": "vp build --ssr",
    "build:all": "vp build && vp build --ssr",
    "dev": "vp dev",
    "typecheck": "tsc --noEmit",
    "check": "vp check resources/js tests/e2e package.json tsconfig.json vite.config.js playwright.config.ts playwright.browser-check.config.ts playwright.browser-check.fixture.ts .codex/skills/run-change-verification/scripts/revision-fingerprint.mjs .codex/skills/run-change-verification/scripts/run-browser-check.mjs .codex/skills/run-change-verification/scripts/validate-change-verification.mjs .codex/skills/run-change-verification/scripts/validate-change-verification.test.mjs",
    "check:fix": "vp check --fix resources/js tests/e2e package.json tsconfig.json vite.config.js playwright.config.ts playwright.browser-check.config.ts playwright.browser-check.fixture.ts .codex/skills/run-change-verification/scripts/revision-fingerprint.mjs .codex/skills/run-change-verification/scripts/run-browser-check.mjs .codex/skills/run-change-verification/scripts/validate-change-verification.mjs .codex/skills/run-change-verification/scripts/validate-change-verification.test.mjs",
    "test": "vp test",
    "test:ci": "vp test --run",
    "test:coverage": "vp test --coverage",
    "test:change-verification": "node --test .codex/skills/run-change-verification/scripts/validate-change-verification.test.mjs",
    "validate:change-verification": "node .codex/skills/run-change-verification/scripts/validate-change-verification.mjs",
    "test:browser-check": "node .codex/skills/run-change-verification/scripts/run-browser-check.mjs",
    "test:browser-check:headed": "node .codex/skills/run-change-verification/scripts/run-browser-check.mjs --headed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:docker": "docker compose --profile e2e run --rm playwright"
  },
  "dependencies": {
    "@inertiajs/react": "^2.3.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@laravel/vite-plugin-wayfinder": "^0.1.7",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "jsdom": "^27.4.0",
    "laravel-vite-plugin": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "npm@11.11.1"
}
